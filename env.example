# The chatbot tries providers in this order and falls through automatically
# if one is unset, rate-limited, out of balance, or times out: Groq -> Cohere
# -> OpenRouter -> DeepSeek. Set as many as you have; only one is required.
GROQ_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
DEEPSEEK_API_KEY=
PORT=8080
